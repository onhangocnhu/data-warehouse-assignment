<mxfile host="drawio-mcp"><diagram id="etlflow" name="Luong ETL"><mxGraphModel dx="1300" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e2" value="&lt;b&gt;Dữ liệu nguồn&lt;/b&gt;&lt;br&gt;9 tập tin CSV (Olist)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;orders, order_items, order_payments,&lt;br&gt;order_reviews, customers, sellers,&lt;br&gt;products, geolocation,&lt;br&gt;category_translation&lt;/font&gt;" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;shape=note;size=16;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="250" height="130" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;1. Extract&lt;/b&gt;&lt;br&gt;Đọc 9 tập tin CSV (UTF-8, bỏ BOM)&lt;br&gt;Giữ mã bưu chính dạng chuỗi&lt;br&gt;Đối chiếu số dòng với nguồn&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;Python&lt;/i&gt;&lt;/font&gt;" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="270" height="130" as="geometry"/></mxCell><mxCell id="e4" value="&lt;b&gt;Staging: bảng thô&lt;/b&gt;&lt;br&gt;stg_orders, stg_order_items, ...&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;PostgreSQL, schema staging&lt;/i&gt;&lt;/font&gt;" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="690" y="45" width="230" height="120" as="geometry"/></mxCell><mxCell id="e5" value="&lt;b&gt;2. Transformation&lt;/b&gt;&lt;br&gt;Làm sạch: theo quy tắc ở Bảng quy tắc xử lý&lt;br&gt;Ánh xạ: kiểu dữ liệu, tên cột, tên thành phố&lt;br&gt;Tích hợp: customer_unique_id, địa lý, ngành hàng&lt;br&gt;Quy tắc nghiệp vụ: số ngày, cờ giao trễ, vùng&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;Python và SQL&lt;/i&gt;&lt;/font&gt;" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="360" height="160" as="geometry"/></mxCell><mxCell id="e6" value="&lt;b&gt;Staging: bảng đã làm sạch&lt;/b&gt;&lt;br&gt;dữ liệu sẵn sàng để nạp&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;PostgreSQL, schema staging&lt;/i&gt;&lt;/font&gt;" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="200" y="270" width="240" height="120" as="geometry"/></mxCell><mxCell id="e7" value="&lt;b&gt;3. Load&lt;/b&gt;&lt;br&gt;Nạp bảng chiều trước:&lt;br&gt;date, state, city, category,&lt;br&gt;product, customer, seller&lt;br&gt;Tra cứu surrogate key, nạp bảng fact&lt;br&gt;Full load trong một transaction" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="300" height="150" as="geometry"/></mxCell><mxCell id="e8" value="&lt;b&gt;Data Mart&lt;/b&gt;&lt;br&gt;snowflake schema&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;PostgreSQL&lt;/i&gt;&lt;/font&gt;" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="400" y="490" width="220" height="130" as="geometry"/></mxCell><mxCell id="e9" value="&lt;b&gt;4. Kiểm tra chất lượng&lt;/b&gt;&lt;br&gt;Đối soát số dòng, tổng tiền,&lt;br&gt;số đơn hàng&lt;br&gt;Kiểm tra toàn vẹn tham chiếu" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="240" height="130" as="geometry"/></mxCell><mxCell id="e10" value="&lt;b&gt;Metadata và nhật ký ETL&lt;/b&gt;&lt;br&gt;từ điển dữ liệu,&lt;br&gt;nguồn gốc dữ liệu,&lt;br&gt;nhật ký từng lần chạy&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;PostgreSQL&lt;/i&gt;&lt;/font&gt;" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1010" y="270" width="200" height="140" as="geometry"/></mxCell><mxCell id="e11" value="đọc tập tin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="nạp nguyên trạng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="e3" target="e4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="đọc dữ liệu thô" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="e4" target="e5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="ghi dữ liệu sạch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="e5" target="e6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="đọc dữ liệu sạch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="e6" target="e7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="nạp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="e7" target="e8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="đối soát" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="e8" target="e9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#B09500;strokeWidth=1;fontColor=#7A6700;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="e3" target="e10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="72"/></Array></mxGeometry></mxCell><mxCell id="e19" value="ghi nhật ký" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#B09500;strokeWidth=1;fontColor=#7A6700;" edge="1" parent="1" source="e5" target="e10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#B09500;strokeWidth=1;fontColor=#7A6700;" edge="1" parent="1" source="e9" target="e10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="555"/></Array></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#B09500;strokeWidth=1;fontColor=#7A6700;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="e7" target="e10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="660"/><mxPoint x="1150" y="660"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>