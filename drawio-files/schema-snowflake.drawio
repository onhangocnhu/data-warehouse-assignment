        <mxCell id="e9" parent="1" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;4. Kiểm tra chất lượng&lt;/b&gt;&lt;br&gt;Đối soát số dòng, tổng tiền,&lt;br&gt;số đơn hàng&lt;br&gt;Kiểm tra toàn vẹn tham chiếu" vertex="1">
