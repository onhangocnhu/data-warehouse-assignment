        </mxCell>
        <mxCell id="e4" parent="1" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFE6CC;strokeColor=#D79B00;" value="&lt;b&gt;Staging: bảng thô&lt;/b&gt;&lt;br&gt;stg_orders, stg_order_items, ...&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;PostgreSQL, schema staging&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="230" x="730" y="45" as="geometry" />
        </mxCell>
        <mxCell id="e5" parent="1" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;2. Transformation&lt;/b&gt;&lt;br&gt;Làm sạch: theo quy tắc ở Bảng quy tắc xử lý&lt;br&gt;Ánh xạ: kiểu dữ liệu, tên cột, tên thành phố&lt;br&gt;Tích hợp: customer_unique_id, địa lý, ngành hàng&lt;br&gt;Quy tắc nghiệp vụ: số ngày, cờ giao trễ, vùng&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;Python và SQL&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="360" x="560" y="250" as="geometry" />
        </mxCell>
        <mxCell id="e6" parent="1" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFE6CC;strokeColor=#D79B00;" value="&lt;b&gt;Staging: bảng đã làm sạch&lt;/b&gt;&lt;br&gt;dữ liệu sẵn sàng để nạp&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;PostgreSQL, schema staging&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="240" x="200" y="270" as="geometry" />
        </mxCell>
        <mxCell id="e7" parent="1" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;3. Load&lt;/b&gt;&lt;br&gt;Nạp bảng chiều trước:&lt;br&gt;date, state, city, category,&lt;br&gt;product, customer, seller&lt;br&gt;Tra cứu surrogate key, nạp bảng fact&lt;br&gt;Full load trong một transaction" vertex="1">
          <mxGeometry height="150" width="300" x="20" y="480" as="geometry" />
        </mxCell>
        <mxCell id="e8" parent="1" style="fontFamily=Helvetica;whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;Data Mart&lt;/b&gt;&lt;br&gt;snowflake schema&lt;br&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;i&gt;PostgreSQL&lt;/i&gt;&lt;/font&gt;" vertex="1">
